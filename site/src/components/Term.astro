---
import { findEntry } from "../lib/glossary";

interface Props {
    /** Glossary name to look up, e.g. "Julian Day"; the slotted text is shown instead, if given. */
    of: string;
}
const { of } = Astro.props;
const entry = findEntry(of);
const label = Astro.slots.has("default") ? await Astro.slots.render("default") : of;
---

<span class="term" tabindex="0"
    ><Fragment set:html={label} /><span class="term-tip" role="tooltip"
        ><strong>{entry.term}</strong> <Fragment set:html={entry.html} /></span
    ></span
>
