---
import Term from "../Term.astro";
import "./sternzeit.css";
---

<figure class="scene-frame wide" id="sun-path">
    <div class="dome-scene" data-export="sun-path-diagram">
        <svg class="dome-layer" data-layer="below" aria-hidden="true"></svg>
        <svg class="dome-layer" data-layer="ground" aria-hidden="true"></svg>
        <svg class="dome-layer" data-layer="above" aria-hidden="true"></svg>
        <div class="dome-compass" aria-hidden="true"></div>
        <div class="analemma-panel" data-export="analemma">
            <svg aria-hidden="true"></svg>
            <span class="analemma-caption"
                ><span class="subfigure-title">analemma</span>: the Sun at this time of day, all year<span
                    data-field="analemmaNote"></span
            ></span>
        </div>
        <p class="vis-credit footnote">
            Drag to rotate. Visualized with <a href="https://zzz.dog/" target="_blank" rel="noopener">Zdog</a>.
        </p>
    </div>
    <figcaption class="figure-caption">
        A <Term of="Sun path diagram">sun path diagram</Term>: the Sun's path (a dot per hour) and the Moon's (grey)
        across the sky of the chosen place, local midnight to midnight, dotted below the horizon, arrows pointing forward in time. The Sun and
        the Moon are symbols, not to scale. (a) The Sun's <Term of="Analemma">analemma</Term> at this time of day, its
        dots two weeks apart.
    </figcaption>
</figure>

<script>
    import "./dayarc.js";
</script>
