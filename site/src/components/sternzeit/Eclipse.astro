---
import Term from "../Term.astro";
import "./sternzeit.css";
---

<figure class="eclipse-figure">
<div class="eclipse-views">
    <figure class="eclipse-view" data-kind="solar" data-export="solar-eclipse">
        <svg viewBox="-100 -100 200 200" aria-hidden="true"></svg>
        <figcaption>
            <span class="eclipse-title">solar</span>, as seen from the chosen place: <span data-field="status"></span>
            <span class="eclipse-orientation">zenith up, azimuth increasing to the right</span>
            <button type="button" data-jump="solar">jump to Burgos, 2026-08-12</button>
        </figcaption>
    </figure>
    <figure class="eclipse-view" data-kind="lunar" data-export="lunar-eclipse">
        <svg viewBox="-100 -100 200 200" aria-hidden="true"></svg>
        <figcaption>
            <span class="eclipse-title">lunar</span>, the same from anywhere: <span data-field="status"></span>
            <span class="eclipse-orientation">ecliptic north up, east left, as on the sky</span>
            <button type="button" data-jump="lunar">jump to Potsdam, 2015-09-28</button>
        </figcaption>
    </figure>
</div>
    <figcaption class="figure-caption">
        Eclipses. Left: the Moon in front of the Sun, as seen from the chosen place. Right: the Moon in Earth's{" "}
        <Term of="Umbra">umbra</Term> and <Term of="Penumbra">penumbra</Term>. Magnified,
        but discs, shadows and horizon true to each other. Corona modified from a{" "}
        <a href="https://philhart.com/exmouth-eclipse/" target="_blank" rel="noopener">photograph by Phil Hart</a> of the
        total eclipse of 20 April 2023, from Exmouth, Western Australia.
    </figcaption>
</figure>

<script>
    import "./eclipse.js";
</script>
