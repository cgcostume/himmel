---
import { getCollection } from "astro:content";
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const chapters = (await getCollection("chapters")).sort((a, b) => a.data.order - b.data.order);
const current = Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&family=Roboto+Mono:wght@300;400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href={`${base}/`}>himmel / sternwarte</a>
            {/* Only shown where the chapters no longer fit on one line; see the script at the end of the body. */}
            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Chapters">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4.5h12M2 8h12M2 11.5h12" /></svg>
            </button>
            <nav id="site-nav">
                {
                    chapters.map((c) => (
                        <a href={`${base}/${c.id}/`} aria-current={current === `${base}/${c.id}` ? "page" : undefined}>
                            {c.data.title}
                        </a>
                    ))
                }
                <a href="https://github.com/cgcostume/himmel" target="_blank" rel="noopener">GitHub ↗</a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer class="site-footer">
            <span>
                A TypeScript + WebGPU port of{" "}
                <a href="https://github.com/cgcostume/osghimmel" target="_blank" rel="noopener">osgHimmel</a>{" "}
                by Daniel Limberger. MIT licensed. The accent blue is a step of Saussure's cyanometer.
            </span>
        </footer>
        <script>
            // Keeps glossary and citation tooltips inside the viewport: shifted left by however far they would overflow.
            const fit = (event: Event) => {
                const tip = (event.target as Element).closest?.(".term, .cite")?.querySelector<HTMLElement>(".term-tip");
                if (!tip) return;
                tip.style.setProperty("--tip-shift", "0px");
                const overflow = tip.getBoundingClientRect().right - (document.documentElement.clientWidth - 16);
                if (overflow > 0) tip.style.setProperty("--tip-shift", `${-overflow}px`);
            };
            document.addEventListener("pointerover", fit);
            document.addEventListener("focusin", fit);

            // The chapter list folds behind the burger on a narrow screen (the CSS decides where); it opens on a
            // press and closes again on the next one, on Escape, or on a press anywhere else.
            const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
            const nav = document.getElementById("site-nav");
            const setNav = (open: boolean) => {
                nav?.toggleAttribute("data-open", open);
                toggle?.setAttribute("aria-expanded", String(open));
            };
            toggle?.addEventListener("click", (event) => {
                event.stopPropagation();
                setNav(!nav?.hasAttribute("data-open"));
            });
            document.addEventListener("click", (event) => {
                if (!nav?.contains(event.target as Node)) setNav(false);
            });
            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") setNav(false);
            });
        </script>
    </body>
</html>
