---
import { getCollection, render } from "astro:content";
import References from "../../components/References.astro";
import Base from "../../layouts/Base.astro";
import { loadGlossary } from "../../lib/glossary";

export async function getStaticPaths() {
    const chapters = await getCollection("chapters");
    return chapters.map((chapter) => ({ params: { chapter: chapter.id }, props: { chapter } }));
}
const { chapter } = Astro.props;
const { Content } = await render(chapter);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const hasGlossary = loadGlossary(chapter.id) !== null;
---

<Base title={`${chapter.data.package}: ${chapter.data.summary}`} description={chapter.data.summary}>
    <h1 class="mono">{chapter.data.package}</h1>
    <p class="lead">{chapter.data.summary}</p>
    {
        hasGlossary && (
            <p class="chapter-meta">
                Unfamiliar term? Hover it, or see the <a href={`${base}/${chapter.id}/glossary/`}>glossary</a>.
            </p>
        )
    }
    <Content />
    <References chapter={chapter.id} body={chapter.body ?? ""} />
</Base>
