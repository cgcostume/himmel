---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const chapters = (await getCollection("chapters")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="himmel: sky rendering for WebGPU" description="Small, composable TypeScript + WebGPU libraries for rendering the sky.">
    <h1>himmel</h1>
    <p class="lead">
        A family of small, independent, composable TypeScript + WebGPU libraries for rendering the sky. Each one drops
        into an existing renderer without pulling in the rest.
    </p>
    <ul class="chapter-list">
        {
            chapters.map((c) => (
                <li>
                    <a href={`${base}/${c.id}/`}>
                        <span class="mono">{c.data.package}</span>
                        {c.data.planned && <span class="planned">planned</span>}
                        <p>{c.data.summary}</p>
                    </a>
                </li>
            ))
        }
    </ul>
</Base>
